# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — ห้าม commit .env เด็ดขาด
# บนเซิร์ฟเวอร์ให้ตั้งค่าเหล่านี้ที่ GitHub Secrets และ Netlify Environment Variables แทน

# Claude API สำหรับ AI Agents (เฟส 2 เป็นต้นไป)
ANTHROPIC_API_KEY=

# รหัสผ่านเข้าเว็บ (ตั้งเองได้ ใช้ตัวยาวๆ)
SITE_PASSWORD=

# ใช้เซ็น session cookie — สุ่มสตริงยาว 32+ ตัวอักษร
SESSION_SECRET=

# SEC Open API สำหรับกองทุนรวมไทย (เฟส 3 — ยังไม่ต้องใส่ตอนนี้)
SEC_API_KEY=
